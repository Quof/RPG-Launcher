<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <AssemblyName>RPG Launcher</AssemblyName>
    <RootNamespace>RpgLauncher</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>RPG Launcher</Product>
    <AssemblyTitle>RPG Launcher</AssemblyTitle>
    <Description>Cover-flow launcher for RPG Maker and Wolf RPG Editor games</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="RpgLauncher.app.ico" />
    <EmbeddedResource Include="Assets\*.png" LogicalName="RpgLauncher.Assets.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
