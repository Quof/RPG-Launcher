<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <AssemblyName>RPG Launcher</AssemblyName>
    <RootNamespace>RpgLauncher</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>RPG Launcher</Product>
    <AssemblyTitle>RPG Launcher</AssemblyTitle>
    <Description>Cover-flow launcher for RPG Maker, Wolf RPG Editor, Ren'Py, TyranoBuilder and Unity games</Description>
    <Version>0.7.0</Version>
    <FileVersion>0.7.0.0</FileVersion>
    <InformationalVersion>0.7.0</InformationalVersion>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Avalonia's build-time usage statistics: not sent from this project. -->
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="RpgLauncher.app.ico" />
    <EmbeddedResource Include="Assets\*.png" LogicalName="RpgLauncher.Assets.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
